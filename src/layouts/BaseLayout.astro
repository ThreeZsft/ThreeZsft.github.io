---
import "@/styles/global.css";
import BaseHead from "@/components/Utility/BaseHead.astro";
import SkipLink from "@/components/Global/SkipLink.astro";
import Nav from "@/components/Global/Nav.astro";
import Footer from "@/components/Global/Footer.astro";
import DotField from "@/components/Motion/DotField.astro";
import Cursor from "@/components/Motion/Cursor.astro";
import EdgeBlur from "@/components/Motion/EdgeBlur.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "inherit", overlap = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <DotField />
    <Cursor />
    <EdgeBlur />
    <Nav overlap={overlap} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { reduced } from "@/scripts/motion.ts";

  /**
   * Anything marked `data-reveal` starts displaced and settles as it comes
   * into view. `row` members stagger along their row; everything else rises.
   * Under reduced motion the elements still fade, they just don't travel.
   */
  const targets = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
  const still = reduced();

  for (const el of targets) {
    const row = el.dataset.reveal === "row";
    const index = row ? [...(el.parentElement?.children || [])].indexOf(el) : 0;
    const delay = index * 90;
    el.style.opacity = "0";
    if (!still) el.style.transform = row ? "translateX(72px)" : "translateY(44px)";
    el.style.transition = `opacity .85s cubic-bezier(.22, 1, .36, 1) ${delay}ms, transform .85s cubic-bezier(.22, 1, .36, 1) ${delay}ms`;
  }

  if (targets.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.style.opacity = "1";
          el.style.transform = "none";
          observer.unobserve(el);
        }
      },
      { threshold: 0.12, rootMargin: "0px 0px -10% 0px" },
    );
    for (const el of targets) observer.observe(el);
  }
</script>
