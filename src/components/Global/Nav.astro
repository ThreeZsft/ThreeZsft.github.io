---
import NavLink from "@/components/Global/NavLink.astro";
import Button from "@/components/Button.astro";
import { NAV_LINKS } from "@/data/home.ts";
import LogoPane from "@/components/Brand/LogoPane.astro";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---
{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/#top" aria-label={SITE_NAME}>
          <LogoPane />
          <span class="nav_wordmark">{SITE_NAME}</span>
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              {NAV_LINKS.map((link) => (
                <NavLink href={link.href}>{link.label}</NavLink>
              ))}
            </ul>
            <Button element="link" href="/#contact" class="nav_cta sm">
              Book a call
            </Button>
          </div>
        </nav>
      </div>
    </header>
  )
}
{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_links {
      font-family: var(--body-family);
      font-size: var(--text-small);
      letter-spacing: var(--letter-spacing-label-sm, 0.16em);
      text-transform: uppercase;
      color: var(--text-2);
    }

    .nav_logo,
    .footer_logo {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
    }

    .nav_wordmark {
      font-family: var(--display-family);
      font-size: 1rem;
      letter-spacing: var(--letter-spacing-heading);
    }

    /**
     * The nav is not a bar: it is a translucent island floating over the page,
     * so only the pill itself catches the pointer.
     */
    .nav_wrap {
      position: fixed;
      top: 1rem;
      inset-inline: 0;
      z-index: 1000;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      color: var(--text);
      pointer-events: none;
    }

    .nav_inner {
      pointer-events: auto;
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-5);
      padding: 0.625rem 0.75rem 0.625rem 1.25rem;
      border-radius: 1.625rem;
      background-color: rgb(240 236 228 / 72%);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: var(--border-width) solid var(--border);
      box-shadow: 0 8px 24px rgb(22 22 26 / 6%);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
      /* The mark sits inside the pill, snug beside the wordmark. */
      .logo-pane {
        width: 1.625rem;
        height: 1.625rem;
        pointer-events: none;
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: color-mix(in lab, currentcolor 60%, transparent);
      text-decoration: none;
      text-underline-offset: 0.4em;
      text-decoration-thickness: var(--border-width);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    @media (width >= 48rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      /* Links and the call button share one row inside the pill. */
      .nav_menu_inner {
        display: flex;
        align-items: center;
        gap: 1.75rem;
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        gap: 1.5rem;
        font-size: var(--text-small);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        color: var(--text-2);
      }

      .nav_link {
        padding-block: 0;
        &[aria-current="page"] {
          text-decoration: underline;
        }
      }
    }
  }
</style>
