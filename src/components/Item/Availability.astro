---
import type { HTMLAttributes } from "astro/types";
import { AVAILABILITY } from "@/data/home.ts";

interface Props extends HTMLAttributes<"p"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** The line inside the badge. Defaults to the site-wide availability note. */
  label?: string;
}

const { render = true, label = AVAILABILITY, class: className, ...rest } = Astro.props;
---

{
  render && label && (
    <p class:list={["availability_wrap", className]} {...rest}>
      <span class="availability_dot" aria-hidden="true" />
      {label}
    </p>
  )
}

<style is:global>
  @layer components {
    /**
     * A stitched receipt, not a pill: the patina edge on the left records
     * that the shop is open, and only the outer corners are eased.
     */
    .availability_wrap {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      background-color: var(--background-2);
      border-left: var(--border-thick, 2px) solid var(--success);
      border-radius: 0 var(--radius-small) var(--radius-small) 0;
      font-family: var(--body-family);
      font-size: var(--step--2);
      letter-spacing: var(--letter-spacing-label-sm);
      text-transform: uppercase;
      line-height: 1;
      color: var(--text-2);
      --_trim-top: 0;
      --_trim-bottom: 0;

      .availability_dot {
        flex: none;
        width: 0.3125rem;
        height: 0.3125rem;
        border-radius: var(--radius-round);
        background-color: var(--success);
      }
    }
  }
</style>
