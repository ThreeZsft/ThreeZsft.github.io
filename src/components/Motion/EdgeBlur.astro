---
/**
 * The page dissolves off the bottom of the glass: seven stacked backdrop
 * blurs, each masked to its own band, ramping from a whisper to a wash. Fixed
 * under the nav's layer and blind to the pointer.
 */
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

/** Each band's strength, doubling as it nears the edge. */
const BANDS = [0.5, 1, 2, 4, 8, 16, 32];
const mask = (index: number) => {
  const step = 12.5;
  const from = index * step;
  const solidFrom = from + step;
  const solidTo = from + step * 2;
  const to = from + step * 3;
  return index === BANDS.length - 1
    ? `linear-gradient(to bottom, transparent ${from}%, #000 ${solidFrom}%, #000 100%)`
    : `linear-gradient(to bottom, transparent ${from}%, #000 ${solidFrom}%, #000 ${solidTo}%, transparent ${to}%)`;
};
---

{
  render && (
    <div class="edge-blur" aria-hidden="true">
      {BANDS.map((blur, index) => (
        <div
          style={`backdrop-filter: blur(${blur}px); -webkit-backdrop-filter: blur(${blur}px); mask-image: ${mask(index)}; -webkit-mask-image: ${mask(index)};`}
        />
      ))}
    </div>
  )
}

<style is:global>
  @layer components {
    .edge-blur {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      height: clamp(6rem, 16vh, 10rem);
      z-index: 900;
      pointer-events: none;

      > div {
        position: absolute;
        inset: 0;
      }
    }
  }
</style>
