---
/**
 * The pointer pair: a small dot that replaces the system cursor, and a badge
 * that trails behind it naming whatever is being hovered. Both appear only for
 * a real pointer that can hover, so touch and keyboard are untouched.
 */
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

/** Line art, stroked in `currentcolor`, keyed by the name a section asks for. */
const GLYPHS = {
  wave: '<path d="M2 12h2.5l3-8.5 4 17 3-11 2 2.5H22" />',
  frame:
    '<rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="8.5" cy="9" r="1.4" /><path d="m21 16-4.2-4.2a2 2 0 0 0-2.8 0L6.5 20" />',
  nodes:
    '<circle cx="12" cy="5" r="2.2" /><circle cx="5" cy="19" r="2.2" /><circle cx="19" cy="19" r="2.2" /><path d="M11 7.1 6 16.9" /><path d="m13 7.1 5 9.8" /><path d="M7.2 19h9.6" />',
  cards:
    '<rect x="3" y="6" width="11" height="15" rx="2" /><path d="m17 4 2.9 1.1a2 2 0 0 1 1.2 2.6L17.2 18" />',
  search: '<circle cx="11" cy="11" r="7" /><path d="m20.5 20.5-4-4" />',
  pen: '<path d="m12 19 7-7 3 3-7 7-3-3z" /><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" /><path d="m2 2 7.586 7.586" /><circle cx="11" cy="11" r="2" />',
  code: '<path d="m8 8-4 4 4 4" /><path d="m16 8 4 4-4 4" /><path d="M13.5 4.5 10.5 19.5" />',
  launch: '<path d="M12 21V4" /><path d="m5 11 7-7 7 7" />',
  page: '<rect x="4" y="5" width="16" height="14" rx="2" /><path d="M4 9.5h16" />',
  pages:
    '<rect x="3" y="7" width="13" height="14" rx="2" /><path d="M8 4h11a2 2 0 0 1 2 2v11" />',
  star: '<path d="M12 3v18" /><path d="m4.2 7.5 15.6 9" /><path d="m19.8 7.5-15.6 9" />',
};
---

{
  render && (
    <Fragment>
      <div class="cursor_dot" aria-hidden="true" />
      <div class="cursor_follower" aria-hidden="true">
        <span class="cursor_follower_glyph" />
        <span class="cursor_follower_label" />
      </div>
      <template class="cursor_glyphs" data-glyphs={JSON.stringify(GLYPHS)} />
    </Fragment>
  )
}

<style is:global>
  @layer components {
    /* Both start hidden and are switched on by script, so a browser without
       it — or a touch device — never sees a stranded dot. */
    .cursor_dot {
      position: fixed;
      left: 0;
      top: 0;
      width: 0.75rem;
      height: 0.75rem;
      border-radius: var(--radius-round);
      background-color: var(--bone-100);
      /* Difference keeps the dot legible on bone and on charcoal alike. */
      mix-blend-mode: difference;
      pointer-events: none;
      z-index: 2000;
      display: none;
      box-sizing: border-box;
      transform: translate(-100px, -100px);
    }

    .cursor_follower {
      position: fixed;
      left: 0;
      top: 0;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.25em;
      width: 4.5rem;
      height: 4.5rem;
      border-radius: var(--radius-round);
      background-color: var(--ember-500);
      color: var(--bone-100);
      text-align: center;
      pointer-events: none;
      z-index: 1500;
      opacity: 0;
      transform: translate(-300px, -300px);
      scale: 0;
      transition:
        opacity var(--dur-quick, 180ms) var(--ease-temper, ease),
        scale var(--dur-quick, 180ms) var(--ease-temper, ease);

      .cursor_follower_label {
        font-size: 0.5rem;
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
        line-height: 1.1;
        max-width: 90%;
      }
      svg {
        width: 1.75rem;
        height: 1.75rem;
        /* Rebuilt on every handover, so the rise replays between cards. */
        animation: follower-icon-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
    }

    @keyframes follower-icon-in {
      from {
        translate: 0 80%;
        opacity: 0;
      }
      to {
        translate: 0 0;
        opacity: 1;
      }
    }

    /* Only once the script has taken over does the system cursor go away. */
    html.has-cursor,
    html.has-cursor * {
      cursor: none !important;
    }
  }
</style>

<script>
  import {
    finePointer,
    lerp,
    rafLoop,
    reduced,
    type FollowerDetail,
  } from "@/scripts/motion.ts";

  const dot = document.querySelector<HTMLElement>(".cursor_dot");
  const follower = document.querySelector<HTMLElement>(".cursor_follower");
  const glyphHost = document.querySelector<HTMLElement>(".cursor_glyphs");

  if (dot && follower && glyphHost && finePointer()) {
    const glyphs: Record<string, string> = JSON.parse(
      glyphHost.dataset.glyphs || "{}",
    );
    const glyphSlot = follower.querySelector<HTMLElement>(
      ".cursor_follower_glyph",
    )!;
    const labelSlot = follower.querySelector<HTMLElement>(
      ".cursor_follower_label",
    )!;

    dot.style.display = "block";
    follower.style.display = "flex";
    document.documentElement.classList.add("has-cursor");

    const INTERACTIVE = "a, button, [role=button], input, select, textarea, label";
    const ease = reduced() ? 0.6 : 0.14;

    let x = -100;
    let y = -100;
    let targetX = x;
    let targetY = y;
    let followX = -300;
    let followY = -300;
    let size = 12;
    let targetSize = 12;
    let hollow = false;
    let down = false;
    let detail: FollowerDetail = null;

    window.addEventListener(
      "pointermove",
      (event) => {
        targetX = event.clientX;
        targetY = event.clientY;
        const target = event.target as Element | null;
        hollow = !!target?.closest?.(INTERACTIVE);
      },
      { passive: true },
    );
    window.addEventListener("pointerdown", () => {
      down = true;
    });
    window.addEventListener("pointerup", () => {
      down = false;
    });

    // Sections announce what the badge should say as the pointer enters them.
    window.addEventListener("tm:follower", (event) => {
      detail = (event as CustomEvent<FollowerDetail>).detail;
      if (detail) {
        glyphSlot.innerHTML = "";
        if (glyphs[detail.glyph]) {
          const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
          svg.setAttribute("viewBox", "0 0 24 24");
          svg.setAttribute("fill", "none");
          svg.setAttribute("stroke", "currentColor");
          svg.setAttribute("stroke-width", "1.5");
          svg.setAttribute("stroke-linecap", "round");
          svg.setAttribute("stroke-linejoin", "round");
          svg.innerHTML = glyphs[detail.glyph];
          glyphSlot.appendChild(svg);
        }
        labelSlot.textContent = detail.label;
      }
      follower.style.opacity = detail ? "1" : "0";
      follower.style.scale = detail ? "1" : "0";
    });

    rafLoop(() => {
      targetSize = down ? 8 : hollow ? 46 : 12;
      x = lerp(x, targetX, ease);
      y = lerp(y, targetY, ease);
      size = lerp(size, targetSize, 0.2);

      dot.style.width = `${size}px`;
      dot.style.height = `${size}px`;
      dot.style.transform = `translate(${x - size / 2}px, ${y - size / 2}px)`;
      // Over a control the dot opens into a ring rather than covering it.
      dot.style.backgroundColor = hollow && !down ? "transparent" : "";
      dot.style.border =
        hollow && !down ? "1px solid var(--bone-100)" : "0";
      // The badge says what the dot would otherwise be sitting on top of.
      dot.style.opacity = detail ? "0" : "1";

      followX = lerp(followX, targetX, 0.16);
      followY = lerp(followY, targetY, 0.16);
      follower.style.transform = `translate(${followX - 36}px, ${followY - 36}px)`;
    });
  }
</script>
