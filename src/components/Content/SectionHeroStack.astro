---
import Availability from "@/components/Item/Availability.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import { PROJECTS } from "@/data/home.ts";

/**
 * The hero and the work index are one scroll movement: the headline gives way
 * as four cards travel from a pile into their places and the statement
 * arrives behind them.
 *
 * The cards sit in their final slots in the markup. Script displaces them
 * backward toward the pile and eases that displacement out, so with no script
 * (or under reduced motion) what remains is an ordinary hero above an
 * ordinary grid.
 */
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;

/** Each card's resting tilt, unwound to zero as it lands. */
const TILTS = [-7, 4, -2, 8, -5, 3];
const GLYPHS = ["nodes", "wave", "frame", "cards", "code", "star"];
---
{
  render && (
    <section class="hero-stack_wrap">
      <div id="work" class="hero-stack_anchor" aria-hidden="true" />
      <div class="hero-stack_stage">
        <div class="hero-stack_inner">
          <div class="hero-stack_headline">
            <Availability />
            <Heading tag="h1" variant="display" maxWidth={24}>
              I'm Josh, a web designer who builds places, not pages.
            </Heading>
            <Paragraph variant="large" maxWidth={46} class="hero-stack_lead">
              Websites and identity for Alberta's creative businesses.
            </Paragraph>
            <ButtonWrapper>
              <Button element="link" href="#contact" class="lg">
                Book a call
              </Button>
            </ButtonWrapper>
          </div>

          <div class="hero-stack_work">
            <h2 class="hero-stack_statement"><span class="hero-stack_statement_text"> Every business has a front <em>window</em>. Yours just happens to open in a browser. </span></h2>
            <div class="hero-stack_pile" aria-hidden="true" />
            <ol class="hero-stack_grid">
              {PROJECTS.map((project, index) => (
                <li class="hero-stack_slot">
                  <a
                    class="hero-stack_card"
                    href={project.href}
                    data-tilt={TILTS[index]}
                    data-glyph={GLYPHS[index]}
                    data-client={project.client}
                  >
                    <div class="hero-stack_visual" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="9" cy="9" r="2" />
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                      </svg>
                      <span>{project.client} preview</span>
                    </div>
                    <div class="hero-stack_body">
                      <h3 class="hero-stack_title">{project.title}</h3>
                      <div class="hero-stack_desc">
                        <p>{project.desc}</p>
                      </div>
                    </div>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    .hero-stack_wrap {
      position: relative;

      .hero-stack_anchor {
        position: absolute;
        top: 0;
        width: 1px;
        height: 1px;
      }

      .hero-stack_inner {
        display: flex;
        flex-direction: column;
        gap: var(--space-7);
        width: var(--site-width);
        max-width: var(--max-width-main);
        margin-inline: auto;
        /* Clears the floating nav, then the design's own 112 / 64 rhythm. */
        padding-block: 7rem 4rem;
      }

      .hero-stack_headline {
        display: flex;
        flex-direction: column;
        align-items: start;
        gap: var(--space-4);
        width: min(100%, 35rem);
      }

      .hero-stack_lead {
        line-height: var(--line-height-large);
        color: var(--text-2);
      }

      .hero-stack_headline h1 {
        /* Height-aware, so a short window never pushes the cards off screen. */
        font-size: clamp(2rem, min(4.4vw, 6.5vh), 3.5625rem);
      }

      .hero-stack_work {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        position: relative;
      }

      /* Statement and label sit on one baseline, pushed to opposite ends.
         The leading-trim pseudo-elements have to go: on a flex container they
         stop being spacing and become items, indenting the first line. */
      .hero-stack_statement {
        &::before,
        &::after {
          content: none;
        }
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: var(--space-3);
        font-family: var(--display-family);
        font-size: 2.074rem;
        font-weight: var(--primary-regular);
        line-height: 1.1;
        letter-spacing: var(--letter-spacing-heading);
      }

      .hero-stack_statement_text {
        max-width: 22ch;
        text-wrap: balance;
      }

      .hero-stack_eyebrow {
        font-family: var(--body-family);
        font-size: var(--text-small);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
        color: var(--text-2);
      }

      /* Where the cards are gathered before they fan out. Never painted. */
      .hero-stack_pile {
        position: absolute;
        right: 6%;
        top: 50%;
        width: 1px;
        height: 1px;
      }

      .hero-stack_grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(16.25rem, 1fr));
        gap: var(--site-gutter);
      }

      .hero-stack_card {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 17rem;
        overflow: clip;
        border: var(--border-width) solid transparent;
        border-radius: 0.6875rem;
        background:
          var(--paper-surface) padding-box,
          var(--paper-ring) border-box;
        box-shadow: var(--paper-inset), var(--paper-lift);
        transition: box-shadow var(--hover-duration) var(--hover-ease);
      }

      /* The work is the exhibit: a plain well until a real image lands in it.
         It takes whatever height is left rather than holding a ratio, so the
         card can be squeezed into the pinned grid without losing its words. */
      .hero-stack_visual {
        aspect-ratio: 1 / 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;

        svg {
          width: 1.25rem;
          height: 1.25rem;
          opacity: 0.55;
        }
        margin: 0.625rem 0.625rem 0;
        background-color: var(--bone-sunken);
        border-radius: var(--radius-small);
        border-bottom: var(--border-width) solid var(--heading-accent);
        overflow: clip;
        font-size: var(--text-small);
        letter-spacing: var(--letter-spacing-label-sm);
        text-transform: uppercase;
        color: var(--text-2);
        text-align: center;
      }

      /* The chin: the deep margin a polaroid keeps for its caption. */
      .hero-stack_body {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-height: 0;
        padding: 0.875rem 0.75rem 1.375rem;
      }

      .hero-stack_title {
        font-family: var(--display-family);
        font-size: clamp(1.0625rem, 1.5vw, 1.5rem);
        font-weight: var(--primary-regular);
        line-height: 1.15;
        text-wrap: pretty;
      }

      .hero-stack_tags {
        font-size: var(--step--2, 0.694rem);
        letter-spacing: var(--letter-spacing-label-sm);
        text-transform: uppercase;
        line-height: 1.5;
        color: var(--text-2);
      }

      /* Collapsed to nothing until the card is hovered or focused within. */
      .hero-stack_desc {
        display: grid;
        grid-template-rows: 0fr;
        font-size: var(--text-small);
        color: var(--text-2);
        line-height: 1.5;
        transition: grid-template-rows var(--open-duration) var(--open-ease);
        > p {
          overflow: hidden;
          /* Space between the tag line and the reveal, hidden while shut. */
          padding-top: 0.375rem;
        }
      }
      @media (hover: hover) {
        .hero-stack_card:hover .hero-stack_desc {
          grid-template-rows: 1fr;
        }
      }
      .hero-stack_card:focus-within .hero-stack_desc {
        grid-template-rows: 1fr;
      }
      @media (hover: none) {
        .hero-stack_desc {
          grid-template-rows: 1fr;
        }
      }
    }

    /**
     * Only once script has measured the layout does the section become a tall
     * scroll track with a pinned stage. Without it the block above stands on
     * its own.
     */
    html.has-stack .hero-stack_wrap {
      height: 340svh;

      .hero-stack_anchor {
        top: auto;
        bottom: 100svh;
        scroll-margin: 0;
      }

      .hero-stack_stage {
        position: sticky;
        top: 0;
        height: 100svh;
        overflow: clip;
        padding-block: 6rem 2.5rem;
      }
      .hero-stack_inner {
        position: relative;
        height: 100%;
        padding-block: 0;
      }
      .hero-stack_headline {
        position: absolute;
        left: 0;
        top: 50%;
        translate: 0 -50%;
        z-index: 2;
        max-height: 100%;
        gap: clamp(0.75rem, 2.5vh, 1.75rem);
        will-change: opacity, transform;
      }
      .hero-stack_work {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
      }
      .hero-stack_statement {
        will-change: opacity;
      }
      /* Pinned, the six rooms read as three across and two down. */
      .hero-stack_grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        grid-template-rows: repeat(2, minmax(0, 1fr));
        min-height: 0;
      }
      /* Pinned, the photo yields its ratio so the card fits its row. */
      .hero-stack_visual {
        aspect-ratio: auto;
        flex: 1;
        min-height: 52%;
      }
      .hero-stack_card {
        min-height: 0;
        will-change: transform;
        transition:
          box-shadow var(--dur-base, 320ms) var(--ease-temper, ease),
          scale var(--dur-base, 320ms) var(--ease-temper, ease);
      }

      /* Until the cards land, the whole stack is one invitation. */
      &.is-gathered .hero-stack_work {
        cursor: pointer;
      }
      @media (hover: hover) {
        &.is-gathered .hero-stack_work:hover .hero-stack_card {
          scale: 1.02;
          box-shadow: var(--paper-inset), 0 16px 40px rgb(22 22 26 / 12%);
        }
      }
      /* The card's words arrive only in the last quarter of its travel. */
      .hero-stack_body {
        opacity: clamp(0, calc((var(--e, 0) - 0.75) * 4), 1);
      }
    }
  }
</style>

<script>
  import {
    clamp,
    easeInOutCubic,
    reduced,
    setFollower,
  } from "@/scripts/motion.ts";

  const wrap = document.querySelector<HTMLElement>(".hero-stack_wrap");
  const stage = wrap?.querySelector<HTMLElement>(".hero-stack_stage");
  const inner = wrap?.querySelector<HTMLElement>(".hero-stack_inner");
  const headline = wrap?.querySelector<HTMLElement>(".hero-stack_headline");
  const statement = wrap?.querySelector<HTMLElement>(".hero-stack_statement");
  const pile = wrap?.querySelector<HTMLElement>(".hero-stack_pile");
  const cards = [...(wrap?.querySelectorAll<HTMLElement>(".hero-stack_card") || [])];

  if (wrap && stage && inner && headline && statement && pile && cards.length) {
    // Below tablet the cards are a single column and a pinned three-screen
    // hero would be a fight rather than a flourish, so the track stays off.
    const wide = window.matchMedia("(min-width: 48rem)");
    let running = false;
    let frame = 0;
    // The displacement currently applied to each card, so a fresh measurement
    // can be read back to its resting position.
    const offsets = cards.map(() => ({ dx: 0, dy: 0 }));

    let teasing = false;

    const clear = () => {
      wrap.classList.remove("is-gathered");
      if (teasing) {
        teasing = false;
        setFollower(null);
      }
      for (const offset of offsets) {
        offset.dx = 0;
        offset.dy = 0;
      }
      headline.style.opacity = "";
      headline.style.transform = "";
      headline.style.pointerEvents = "";
      statement.style.opacity = "";
      for (const card of cards) {
        card.style.transform = "";
        card.style.removeProperty("--e");
      }
    };

    const update = () => {
      frame = 0;
      if (!running) return;

      const rect = wrap.getBoundingClientRect();
      const travel = Math.max(1, rect.height - window.innerHeight);
      const progress = clamp(-rect.top / travel);

      // The headline clears the stage first.
      const fade = clamp(progress / 0.3);
      headline.style.opacity = `${1 - fade}`;
      headline.style.transform = `translateY(${-fade * 40}px)`;
      headline.style.pointerEvents = fade > 0.9 ? "none" : "auto";

      // The statement arrives once the cards are most of the way home.
      statement.style.opacity = `${clamp((progress - 0.5) / 0.3)}`;

      // While gathered, the stack reads as one clickable object.
      const gathered = progress < 0.85;
      wrap.classList.toggle("is-gathered", gathered);
      if (!gathered && teasing) {
        teasing = false;
        setFollower(null);
      }

      const pileRect = pile.getBoundingClientRect();
      const innerRect = inner.getBoundingClientRect();
      cards.forEach((card, index) => {
        const cardRect = card.getBoundingClientRect();
        const eased = easeInOutCubic(
          clamp((progress - (0.08 + index * 0.05)) / 0.62),
        );
        const away = 1 - eased;

        // Subtract the displacement already applied to recover where the card
        // actually rests in the grid.
        const restX = cardRect.left - offsets[index].dx;
        const restY = cardRect.top - offsets[index].dy;
        // The pile leans toward the right margin but stays inside the frame.
        const startX = clamp(
          pileRect.left - cardRect.width / 2 + (index % 2 ? 10 : -10),
          innerRect.left + 8,
          innerRect.right - cardRect.width - 8,
        );
        const dx = (startX - restX) * away;
        const dy =
          (pileRect.top - restY - cardRect.height / 2 + (index % 2 ? 8 : -6) + index * 3) *
          away;
        const tilt = Number(card.dataset.tilt || 0) * away;

        offsets[index] = { dx, dy };
        card.style.setProperty("--e", `${eased}`);
        card.style.transform = `translate(${dx}px, ${dy}px) rotate(${tilt}deg)`;
        card.style.zIndex = `${3 + index}`;
        // Nothing is clickable until it has arrived.
        card.style.pointerEvents = progress > 0.85 ? "auto" : "none";
      });
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    const sync = () => {
      const next = wide.matches && !reduced();
      if (next === running) {
        if (running) update();
        return;
      }
      running = next;
      document.documentElement.classList.toggle("has-stack", running);
      if (running) {
        for (const offset of offsets) {
          offset.dx = 0;
          offset.dy = 0;
        }
        update();
      } else {
        clear();
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", sync);
    wide.addEventListener("change", sync);
    sync();
    // Fonts landing changes card heights, so measure again once they have.
    document.fonts?.ready.then(sync);

    const work = wrap.querySelector<HTMLElement>(".hero-stack_work");
    work?.addEventListener("pointerenter", () => {
      if (running && wrap.classList.contains("is-gathered")) {
        teasing = true;
        setFollower({ label: "See the work", glyph: "frame" });
      }
    });
    work?.addEventListener("pointerleave", () => {
      if (teasing) {
        teasing = false;
        setFollower(null);
      }
    });
    work?.addEventListener("click", () => {
      if (!running) return;
      const rect = wrap.getBoundingClientRect();
      const travel = Math.max(1, rect.height - window.innerHeight);
      if (clamp(-rect.top / travel) >= 0.85) return;
      window.scrollTo({ top: wrap.offsetTop + travel, behavior: "smooth" });
    });

    // Each card names itself on the follower badge.
    for (const card of cards) {
      card.addEventListener("pointerenter", () =>
        setFollower({
          label: card.dataset.client || "",
          glyph: card.dataset.glyph || "frame",
        }),
      );
      card.addEventListener("pointerleave", () => setFollower(null));
    }
  }
</script>
