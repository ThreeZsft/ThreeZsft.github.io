---
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import { STEPS } from "@/data/home.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <div class="process-main_wrap">
      <div class="process-main_head">
        <div class="process-main_intro" data-reveal="single">
          <Eyebrow tag="h2">Process</Eyebrow>
          <Heading tag="h3" variant="h2">
            How it goes
          </Heading>
        </div>
      </div>
      <Grid variant="autofit" minColumnWidth={15} class="process-main_layout">
        {STEPS.map((step, index) => (
          <article class="process-main_step" data-reveal="row">
            <div class="process-main_top">
              <span class="process-main_tile" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <h4 class="process-main_title">{step.name}</h4>
            <p class="process-main_text">{step.body}</p>
          </article>
        ))}
      </Grid>
    </div>
  )
}

<style is:global>
  @layer components {
    .process-main_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);

      /* Title left, the timing note dropped to its baseline on the right. */
      .process-main_head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        flex-wrap: wrap;
        gap: var(--space-5);
      }
      .process-main_intro {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        max-width: 40rem;
      }
      .process-main_note {
        font-size: var(--text-small);
        color: var(--text-2);
      }

      .process-main_step {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        height: 100%;
        padding: 1.5rem;
        border: var(--border-width) solid transparent;
        border-radius: 0.6875rem;
        background:
          var(--paper-surface) padding-box,
          var(--paper-ring) border-box;
        box-shadow: var(--paper-inset), var(--paper-lift);
        transition: opacity var(--hover-duration) var(--hover-ease);
      }

      /* Pointing at one stage quiets the rest of the run. */
      @media (hover: hover) {
        .process-main_layout:hover .process-main_step:not(:hover) {
          opacity: 0.5;
        }
      }

      .process-main_top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
      }

      /* The stage's number, struck into a small raised tile. */
      .process-main_tile {
        display: grid;
        place-items: center;
        width: 2.125rem;
        height: 2.125rem;
        border: var(--border-width) solid transparent;
        border-radius: 0.4375rem;
        background:
          linear-gradient(160deg, #f6f3ed, #e7e2d8) padding-box,
          linear-gradient(160deg, #fbf9f5, #cfc9bb) border-box;
        box-shadow:
          inset 0 1px rgb(255 255 255 / 90%),
          inset 0 -1px rgb(22 22 26 / 6%);
        font-family: var(--body-family);
        font-size: var(--step--2);
        letter-spacing: var(--letter-spacing-label-sm);
        color: var(--text-2);
      }

      .process-main_label {
        font-family: var(--body-family);
        font-size: var(--step--2);
        letter-spacing: var(--letter-spacing-label-sm);
        text-transform: uppercase;
        color: var(--text-2);
      }

      /* The stage names lean into the italic cut. */
      .process-main_title {
        font-family: var(--display-family);
        font-style: italic;
        font-weight: var(--primary-regular);
        font-size: 1.728rem;
        line-height: 1.15;
      }

      .process-main_text {
        margin-top: auto;
        font-size: var(--text-small);
        line-height: var(--line-height-large);
        color: var(--text-2);
      }
    }
  }
</style>
